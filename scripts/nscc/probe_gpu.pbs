#!/bin/bash
# 15-minute single-GPU probe: driver/CUDA version, torch sees the GPU, MPI
# launcher type and its rank variables.   qsub -P <project> scripts/nscc/probe_gpu.pbs
#PBS -N envtok-probe
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=00:15:00
#PBS -j oe
cd "${PBS_O_WORKDIR:-$PWD}"
nvidia-smi
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
echo "--- mpiexec"; command -v mpiexec && (mpiexec --version 2>&1 | head -5)
echo "--- rank variables seen by mpiexec -n 2"; mpiexec -n 2 env | grep -E '^(PALS|PMI|OMPI_COMM_WORLD|MPI_LOCALRANK|SLURM)_' | sort -u
echo "--- network interfaces"; ip -o link show | awk -F': ' '{print $2}'
echo "--- NCCL OFI plugin"; ls /opt/cray/libfabric 2>/dev/null | head; find / -maxdepth 6 -name 'libnccl-net*.so' 2>/dev/null | head
. scripts/nscc/env.sh 2>/dev/null && python -c "import torch; print('torch', torch.__version__, torch.version.cuda, 'cuda available', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"
